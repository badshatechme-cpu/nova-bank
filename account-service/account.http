### There is no "create account" endpoint yet (accounts are provisioned by Phase 4/6 seeding).
### To try these requests against a running account-service backed by docker-compose Postgres,
### seed one row first, e.g.:
###
### docker exec -it novabank-postgres psql -U novabank -d account_db -c "
###   INSERT INTO accounts (id, customer_id, account_number, iban, type, currency, balance, status, opened_at)
###   VALUES ('11111111-1111-1111-1111-111111111111', '22222222-2222-2222-2222-222222222222',
###           'AC-0001', 'AE070331234567890123456', 'CURRENT', 'AED', 1500.00, 'ACTIVE', now());
###   INSERT INTO transactions (id, account_id, type, amount, currency, balance_after, narration, counterparty, booked_at)
###   VALUES ('33333333-3333-3333-3333-333333333333', '11111111-1111-1111-1111-111111111111',
###           'CREDIT', 2000.00, 'AED', 2000.00, 'Salary', 'Employer LLC', now() - interval '10 days'),
###          ('44444444-4444-4444-4444-444444444444', '11111111-1111-1111-1111-111111111111',
###           'DEBIT', 500.00, 'AED', 1500.00, 'Groceries', 'Carrefour', now() - interval '1 day');
###   INSERT INTO accounts (id, customer_id, account_number, iban, type, currency, balance, status, opened_at)
###   VALUES ('55555555-5555-5555-5555-555555555555', '66666666-6666-6666-6666-666666666666',
###           'AC-0002', 'AE070331234567890999999', 'SAVINGS', 'AED', 200.00, 'ACTIVE', now());
### "

### List a customer's accounts
GET http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/accounts

### Get one account and its balance
GET http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/accounts/11111111-1111-1111-1111-111111111111

### List transactions for an account, paged and date-filtered
GET http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/accounts/11111111-1111-1111-1111-111111111111/transactions?from=2020-01-01&page=0&size=10

### Ownership check: wrong customer id returns 404
GET http://localhost:8082/api/v1/customers/99999999-9999-9999-9999-999999999999/accounts/11111111-1111-1111-1111-111111111111

### Transfer funds: success. toAccountId belongs to a different customer on purpose -
### fromAccountId must be owned by the customer in the path, toAccountId does not.
POST http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/transfers
Content-Type: application/json
Idempotency-Key: demo-key-1

{
  "fromAccountId": "11111111-1111-1111-1111-111111111111",
  "toAccountId": "55555555-5555-5555-5555-555555555555",
  "amount": 100.00,
  "currency": "AED",
  "narration": "Rent"
}

### Replay the same request with the same Idempotency-Key: returns the original result, does not post again
POST http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/transfers
Content-Type: application/json
Idempotency-Key: demo-key-1

{
  "fromAccountId": "11111111-1111-1111-1111-111111111111",
  "toAccountId": "55555555-5555-5555-5555-555555555555",
  "amount": 100.00,
  "currency": "AED",
  "narration": "Rent"
}

### Insufficient funds -> 422 ProblemDetail
POST http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/transfers
Content-Type: application/json
Idempotency-Key: demo-key-2

{
  "fromAccountId": "11111111-1111-1111-1111-111111111111",
  "toAccountId": "55555555-5555-5555-5555-555555555555",
  "amount": 999999.00,
  "currency": "AED",
  "narration": "Too much"
}

### Missing Idempotency-Key header -> 400 ProblemDetail
POST http://localhost:8082/api/v1/customers/22222222-2222-2222-2222-222222222222/transfers
Content-Type: application/json

{
  "fromAccountId": "11111111-1111-1111-1111-111111111111",
  "toAccountId": "55555555-5555-5555-5555-555555555555",
  "amount": 10.00,
  "currency": "AED",
  "narration": "No key"
}
